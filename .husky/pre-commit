#!/usr/bin/env bash
# Pre-commit: lint-staged + TypeScript typecheck
# lint-staged runs eslint + tsc on staged files only

set -e

echo ""
echo "  🔍 Running lint-staged (eslint + tsc on staged files)..."
npx lint-staged --no-stash 2>/dev/null || npx lint-staged 2>/dev/null || echo "  ⚠ lint-staged skipped (no staged files)"

echo ""
echo "  🔍 Full typecheck (electron)..."
npx tsc --noEmit --project tsconfig.electron.json

echo ""
echo "  🔍 Full typecheck (server)..."
cd server && npx tsc --noEmit && cd ..

echo ""
echo "  ✅ All checks passed"
