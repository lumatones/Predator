# ── Predator Docker Environment ──
# Copy to .env and adjust for your deployment

# Server
PORT=3001
NODE_ENV=production

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_USER=predator
DB_PASSWORD=change-me-in-production
DB_NAME=predator

# MySQL root (for initialization)
MYSQL_ROOT_PASSWORD=root-change-me

# Client origins (comma-separated)
CLIENT_URL=http://localhost
ALLOW_LOCAL_DEV_ORIGINS=false

# JWT secret (generate with: openssl rand -hex 64)
JWT_SECRET=change-me-to-a-random-64-char-hex

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
