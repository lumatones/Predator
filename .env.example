# Server
PORT=3001
CLIENT_URL=*

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=predator

# Security
JWT_SECRET=change-me-to-random-string-at-least-32-chars
JWT_EXPIRES_IN=24h

# Default admin (used by db:init)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Request expiry time (minutes)
REQUEST_EXPIRY_MINUTES=30
